---
import { IconCheck } from '@tabler/icons-astro';
import Button from './Button.astro';

interface Props {
  id: string;
  eyebrow: string;
  name: string;
  description: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  featured?: boolean;
  badge?: string;
}

const {
  id,
  eyebrow,
  name,
  description,
  features,
  ctaLabel,
  ctaHref,
  featured = false,
  badge,
} = Astro.props;
---

<article
  class:list={['pricing-card', featured && 'pricing-card--featured']}
  id={id}
>
  {
    featured && badge ? (
      <span class="pricing-card__badge">{badge}</span>
    ) : null
  }
  <div class="pricing-card__identity">
    <span class="pricing-card__icon" aria-hidden="true">
      <slot name="icon" />
    </span>
    <div class="pricing-card__titles">
      <p class="pricing-card__eyebrow">{eyebrow}</p>
      <h3 class="pricing-card__name">{name}</h3>
    </div>
  </div>
  <p class="pricing-card__description">{description}</p>
  <ul class="pricing-card__features">
    {
      features.map((feature) => (
        <li>
          <IconCheck size={20} stroke={2} />
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
  <div class="pricing-card__cta">
    <Button href={ctaHref}>{ctaLabel}</Button>
  </div>
</article>

<style>
  .pricing-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-items: start;
    row-gap: var(--space-24);
    box-sizing: border-box;
    min-width: 0;
    height: 100%;
    padding: var(--space-pad-card);
    scroll-margin-top: calc(var(--navbar-height) + var(--space-16));
    border: var(--stroke-width) solid var(--color-gray-300);
    border-radius: var(--radius-2xl);
    background: var(--color-base-white);
  }

  @supports (grid-template-rows: subgrid) {
    .pricing-card {
      grid-template-rows: subgrid;
      grid-row: span 4;
      height: auto;
    }
  }

  .pricing-card--featured {
    border-color: var(--color-primary-500);
  }

  .pricing-card__badge {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    box-sizing: border-box;
    padding: var(--space-6) var(--space-12);
    border: var(--stroke-width) solid var(--color-primary-500);
    border-radius: var(--radius-pill);
    background: var(--color-primary-50);
    color: var(--color-primary-500);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  .pricing-card__identity {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    min-width: 0;
  }

  .pricing-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-50);
    color: var(--color-primary-500);
  }

  .pricing-card__titles {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pricing-card__eyebrow {
    margin: 0;
    color: var(--color-gray-500);
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-heading);
  }

  .pricing-card__name {
    margin: 0;
    color: var(--color-primary-500);
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-bold);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 700;
    letter-spacing: 0;
    line-height: var(--line-height-heading);
  }

  .pricing-card__description {
    margin: 0;
    color: var(--color-gray-500);
    font-family: var(--font-body);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-body);
  }

  .pricing-card__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: 0;
    padding: var(--space-32) 0 0;
    list-style: none;
  }

  .pricing-card__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    min-width: 0;
    color: var(--color-base-black);
    font-family: var(--font-body);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-body);
    overflow-wrap: anywhere;
  }

  .pricing-card__features :global(svg) {
    display: block;
    flex-shrink: 0;
    color: var(--color-primary-500);
  }

  .pricing-card__cta :global(.button) {
    width: 100%;
    align-self: stretch;
  }

  .pricing-card__icon :global(svg) {
    display: block;
    flex-shrink: 0;
  }
</style>
