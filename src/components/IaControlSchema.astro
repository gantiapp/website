---
import { IconCheck, IconChevronDown, IconRobot, IconSend, IconShieldCheck } from '@tabler/icons-astro';

const ruleText = '« Chaque produit actif doit avoir un taux de taxe conforme au référentiel. »';
const promptText = 'Chaque produit actif doit avoir un taux de taxe conforme au référentiel.';
---

<article class="ia-control" data-ia-control aria-hidden="true">
  <header class="ia-control__header">
    <span class="ia-control__mark">
      <IconRobot size={18} stroke={1.75} />
    </span>
    <h3 class="ia-control__title">Du besoin au contrôle</h3>
    <span class="ia-control__step">01 / GAIA</span>
  </header>

  <p class="ia-control__label">Votre règle métier</p>
  <div class="ia-control__quote">
    <p class="ia-control__quote-text">
      <span class="ia-control__sizer" aria-hidden="true">{ruleText}</span>
      <span data-ia-rule>{ruleText}</span>
    </p>
  </div>

  <span class="ia-control__arrow">
    <IconChevronDown size={20} stroke={2} />
  </span>

  <div class="ia-control__proposal">
    <p class="ia-control__label">Proposition de contrôle</p>
    <span class="ia-control__badge">
      <IconCheck size={14} stroke={2.5} />
      À valider par vos équipes
    </span>
  </div>

  <div class="ia-control__sql-wrap">
    <div class="ia-control__loading">
      <div class="ia-control__loading-meta">
        <span class="ia-control__loading-avatar">
          <IconRobot size={16} stroke={1.5} />
        </span>
        <span class="ia-control__loading-name">GAIA</span>
        <time class="ia-control__loading-time" data-ia-loading-time datetime="16:13">16:13</time>
      </div>
      <span class="ia-control__dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </div>
    <pre class="ia-control__sql"><span class="ia-control__line" data-ia-line="1"><span class="ia-control__kw">SELECT</span> product_id, name, tax_rate</span><span class="ia-control__line" data-ia-line="2"><span class="ia-control__kw">FROM</span> PIM_Products</span><span class="ia-control__line" data-ia-line="3"><span class="ia-control__kw">WHERE</span> tax_rate <span class="ia-control__kw">NOT IN</span> (5.5, 20.00);</span></pre>
  </div>

  <p class="ia-control__note">
    <IconShieldCheck size={16} stroke={1.75} />
    Une proposition, jamais une décision à votre place.
  </p>

  <div class="ia-control__composer">
    <div class="ia-control__field">
      <p class="ia-control__composer-copy">
        <span class="ia-control__placeholder">Décrivez votre règle métier...</span>
        <span class="ia-control__sizer" aria-hidden="true">{promptText}</span>
        <span class="ia-control__typed-line">
          <span data-ia-composer-text></span><span class="ia-control__caret"></span>
        </span>
      </p>
      <span class="ia-control__send">
        <IconSend size={16} stroke={1.5} />
      </span>
    </div>
  </div>
</article>

<script>
  import { playWhileVisible, typeText } from '../scripts/ia-schema.js';

  function setupControlSchemas() {
    const schemas = document.querySelectorAll('[data-ia-control]');

    schemas.forEach((schema) => {
      if (!(schema instanceof HTMLElement)) {
        return;
      }

      const rule = schema.querySelector('[data-ia-rule]');
      const composerText = schema.querySelector('[data-ia-composer-text]');
      const composerSizer = schema.querySelector('.ia-control__composer-copy .ia-control__sizer');
      if (!(rule instanceof HTMLElement) || !(composerText instanceof HTMLElement) || !(composerSizer instanceof HTMLElement)) {
        return;
      }

      const prompt = (composerSizer.textContent ?? '').replace(/\s+/g, ' ').trim();
      const stateClasses = ['is-animating', 'is-typing', 'is-sent', 'is-arrow', 'is-loading', 'is-badge', 'is-sql-1', 'is-sql-2', 'is-sql-3'];

      const reset = () => {
        stateClasses.forEach((className) => schema.classList.remove(className));
        schema.classList.add('is-animating');
        composerText.textContent = '';
      };

      playWhileVisible(schema, async (wait) => {
        reset();
        if (!(await wait(500))) {
          return;
        }

        schema.classList.add('is-typing');
        const promptTyped = await typeText(composerText, prompt, 30, wait);
        if (!promptTyped) {
          return;
        }

        if (!(await wait(360))) {
          return;
        }

        schema.classList.remove('is-typing');
        composerText.textContent = '';
        schema.classList.add('is-sent');
        if (!(await wait(380))) {
          return;
        }

        schema.classList.add('is-arrow');
        if (!(await wait(440))) {
          return;
        }

        const loadingTime = schema.querySelector('[data-ia-loading-time]');
        if (loadingTime instanceof HTMLTimeElement) {
          const now = new Date();
          const clock = new Intl.DateTimeFormat(undefined, {
            hour: '2-digit',
            minute: '2-digit',
          }).format(now);
          loadingTime.textContent = clock;
          loadingTime.dateTime = now.toISOString();
        }

        schema.classList.add('is-loading');
        if (!(await wait(1650))) {
          return;
        }

        schema.classList.remove('is-loading');
        if (!(await wait(320))) {
          return;
        }

        schema.classList.add('is-badge');
        if (!(await wait(360))) {
          return;
        }

        schema.classList.add('is-sql-1');
        if (!(await wait(480))) {
          return;
        }

        schema.classList.add('is-sql-2');
        if (!(await wait(480))) {
          return;
        }

        schema.classList.add('is-sql-3');
        await wait(4800);
      });
    });
  }

  setupControlSchemas();
</script>

<style>
  .ia-control {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    box-sizing: border-box;
    width: 100%;
    max-width: 552px;
    margin-left: auto;
    padding: var(--space-20);
    border: var(--stroke-width) solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-base-white);
    box-shadow: 0 0 16px rgb(0 0 0 / 0.08);
  }

  .ia-feature--reverse .ia-control {
    margin-left: 0;
    margin-right: auto;
  }

  .ia-control__header,
  .ia-control__proposal,
  .ia-control__note,
  .ia-control__badge {
    display: flex;
    align-items: center;
  }

  .ia-control__header {
    gap: var(--space-12);
  }

  .ia-control__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-s);
    background: var(--color-primary-500);
    color: var(--color-base-white);
  }

  .ia-control__title {
    margin: 0;
    color: var(--color-primary-800);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
  }

  .ia-control__step {
    margin-left: auto;
    color: var(--color-gray-500);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    line-height: 1;
    white-space: nowrap;
  }

  .ia-control__label {
    margin: 0;
    color: var(--color-gray-500);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .ia-control__quote,
  .ia-control__sql {
    box-sizing: border-box;
    margin: 0;
    border-radius: var(--radius-m);
  }

  .ia-control__quote {
    background: var(--color-gray-100);
  }

  .ia-control__sql {
    background: var(--color-gray-100);
  }

  .ia-control__quote {
    padding: var(--space-16);
  }

  .ia-control__quote-text,
  .ia-control__composer-copy {
    display: grid;
    margin: 0;
  }

  .ia-control__quote-text > *,
  .ia-control__composer-copy > * {
    grid-area: 1 / 1;
  }

  .ia-control__quote-text {
    color: var(--color-primary-800);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    line-height: 1.45;
  }

  .ia-control__sizer,
  .ia-control__typed-line {
    white-space: pre-wrap;
  }

  .ia-control__sizer {
    visibility: hidden;
  }

  .ia-control.is-animating [data-ia-rule] {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .ia-control.is-animating.is-sent [data-ia-rule] {
    opacity: 1;
  }

  .ia-control__caret {
    display: none;
    width: 2px;
    height: 0.95em;
    margin-left: 2px;
    background: var(--color-primary-500);
    vertical-align: -0.12em;
    animation: ia-control-caret 0.9s steps(1) infinite;
  }

  .ia-control.is-typing .ia-control__caret {
    display: inline-block;
  }

  .ia-control__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-500);
  }

  .ia-control__proposal {
    justify-content: space-between;
    gap: var(--space-12);
  }

  .ia-control__badge {
    gap: var(--space-6);
    padding: 4px 8px 4px 4px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-alert-success-500) 16%, white);
    color: color-mix(in srgb, var(--color-alert-success-500) 62%, #14532d);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    white-space: nowrap;
  }

  .ia-control__sql-wrap {
    position: relative;
  }

  .ia-control.is-animating:not(.is-badge) .ia-control__proposal {
    visibility: hidden;
  }

  .ia-control.is-animating:not(.is-sql-1):not(.is-sql-2):not(.is-sql-3) .ia-control__sql {
    background: transparent;
    transition: background-color 0.45s ease;
  }

  .ia-control__loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .ia-control.is-animating.is-loading .ia-control__loading {
    opacity: 1;
    visibility: visible;
  }

  .ia-control__loading-meta {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .ia-control__loading-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-gray-100);
    color: var(--color-gray-600);
  }

  .ia-control__loading-name {
    flex: 1;
    color: var(--color-gray-800);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
  }

  .ia-control__loading-time {
    color: var(--color-gray-600);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    font-weight: 300;
    line-height: 1.2;
  }

  .ia-control__dots {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 40px;
    min-height: 16px;
  }

  .ia-control__dots span {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-500);
    animation: ia-control-dot 1s ease-in-out infinite;
  }

  .ia-control__dots span:nth-child(2) {
    animation-delay: 0.16s;
  }

  .ia-control__dots span:nth-child(3) {
    animation-delay: 0.32s;
  }

  .ia-control__sql {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 88px;
    padding: var(--space-16);
    color: var(--color-primary-800);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  .ia-control__composer {
    display: flex;
  }

  .ia-control__field {
    display: flex;
    align-items: flex-end;
    gap: var(--space-8);
    width: 100%;
    padding: var(--space-8) var(--space-8) var(--space-8) var(--space-16);
    border-radius: var(--radius-m);
    background: var(--color-gray-100);
  }

  .ia-control__composer-copy {
    flex: 1;
    min-width: 0;
    padding: var(--space-6) 0;
    color: var(--color-gray-500);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    line-height: 1.35;
  }

  .ia-control.is-typing .ia-control__composer-copy {
    color: var(--color-primary-800);
  }

  .ia-control.is-typing .ia-control__placeholder {
    display: none;
  }

  .ia-control__send {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: var(--color-gray-200);
    color: var(--color-gray-400);
  }

  .ia-control.is-typing .ia-control__send {
    color: var(--color-primary-50);
    background: var(--color-primary-500);
  }

  .ia-control__kw {
    color: var(--color-primary-500);
    font-weight: var(--font-weight-semibold);
  }

  .ia-control__note {
    gap: var(--space-8);
    margin: 0;
    color: var(--color-gray-500);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    line-height: 1.3;
  }

  .ia-control.is-animating .ia-control__arrow,
  .ia-control.is-animating .ia-control__badge,
  .ia-control.is-animating .ia-control__line {
    opacity: 0;
    transform: translateY(6px);
  }

  .ia-control.is-animating.is-arrow .ia-control__arrow,
  .ia-control.is-animating.is-badge .ia-control__badge,
  .ia-control.is-animating.is-sql-1 .ia-control__line[data-ia-line='1'],
  .ia-control.is-animating.is-sql-2 .ia-control__line[data-ia-line='2'],
  .ia-control.is-animating.is-sql-3 .ia-control__line[data-ia-line='3'] {
    opacity: 1;
    transform: none;
  }

  .ia-control__arrow,
  .ia-control__badge,
  .ia-control__line {
    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ia-control :global(svg) {
    display: block;
    flex-shrink: 0;
  }

  @keyframes ia-control-caret {
    0%,
    50% {
      opacity: 1;
    }

    50.01%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ia-control-dot {
    0%,
    80%,
    100% {
      opacity: 0.28;
      transform: translateY(0);
    }

    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @container (max-width: 1280px) {
    .ia-control,
    .ia-feature--reverse .ia-control {
      margin-left: 0;
      margin-right: auto;
    }
  }

  @media (max-width: 1024px) {
    .ia-control,
    .ia-feature--reverse .ia-control {
      margin-left: 0;
      margin-right: auto;
    }
  }

  @media (max-width: 520px) {
    .ia-control__proposal {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ia-control__caret,
    .ia-control__loading,
    .ia-control__sizer {
      display: none;
    }

    .ia-control.is-animating:not(.is-sql-1):not(.is-sql-2):not(.is-sql-3) .ia-control__sql {
      background: var(--color-gray-100);
    }

    .ia-control.is-animating [data-ia-rule],
    .ia-control.is-animating .ia-control__arrow,
    .ia-control.is-animating .ia-control__badge,
    .ia-control.is-animating .ia-control__line {
      opacity: 1;
      transform: none;
    }
  }
</style>
