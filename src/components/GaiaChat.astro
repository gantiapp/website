---
import {
  IconArrowsMaximize,
  IconChevronDown,
  IconCode,
  IconFlag,
  IconRefresh,
  IconShare2,
  IconUser,
  IconX,
} from '@tabler/icons-astro';
---

<div class="gaia-chat" aria-hidden="true">
  <header class="gaia-chat__toolbar">
      <img
        class="gaia-chat__logo"
        src="/images/ganti/ganti.svg"
        alt=""
        width="23"
        height="20"
      />
      <div class="gaia-chat__toolbar-group">
        <IconShare2 size={20} stroke={1.5} />
        <IconRefresh size={20} stroke={1.5} />
      </div>
      <div class="gaia-chat__toolbar-group gaia-chat__toolbar-group--end">
        <IconArrowsMaximize size={20} stroke={1.5} />
        <IconX size={20} stroke={1.5} />
      </div>
    </header>

    <div class="gaia-chat__thread">
      <article class="gaia-chat__message">
        <div class="gaia-chat__meta">
          <span class="gaia-chat__avatar">
            <IconUser size={16} stroke={1.5} />
          </span>
          <span class="gaia-chat__author">John Doe</span>
          <time class="gaia-chat__time" datetime="16:12">16:12</time>
        </div>
        <p class="gaia-chat__prompt">
          Génère-moi un contrôle permettant d'identifier les produits actifs ayant un
          taux de taxe incohérent dans le référentiel central.
        </p>
      </article>

      <article class="gaia-chat__message">
        <div class="gaia-chat__meta">
          <span class="gaia-chat__avatar">
            <IconFlag size={16} stroke={1.5} />
          </span>
          <span class="gaia-chat__author">GAIA</span>
          <time class="gaia-chat__time" datetime="16:13">16:13</time>
        </div>
        <p class="gaia-chat__answer">
          Voici la requête SQL pour identifier les produits actifs avec un taux de taxe
          incohérent :
        </p>
        <pre class="gaia-chat__sql"><code><span class="gaia-chat__kw">SELECT</span>
    p.product_id,
    p.name,
    p.tax_rate,
    pc.rayon,
    pc.famille,
    pc.sous_famille,
    plc.listed_date,
    plc.delisted_date
<span class="gaia-chat__kw">FROM</span> PIM_Products p
<span class="gaia-chat__kw">INNER JOIN</span> PIM_ProductCategorization pc
    <span class="gaia-chat__kw">ON</span> pc.product_id = p.product_id
<span class="gaia-chat__kw">INNER JOIN</span> PIM_ProductLifeCycle plc
    <span class="gaia-chat__kw">ON</span> plc.product_id = p.product_id
<span class="gaia-chat__kw">WHERE</span>
    p.tax_rate <span class="gaia-chat__kw">NOT IN</span> (5.5, 20.00)
    <span class="gaia-chat__kw">AND</span> plc.delisted_date <span class="gaia-chat__kw">IS NULL</span></code></pre>
      </article>
    </div>

    <div class="gaia-chat__composer">
      <p class="gaia-chat__placeholder">Ask anything to GAIA...</p>
      <div class="gaia-chat__actions">
        <span class="gaia-chat__pill">
          <IconCode size={16} stroke={1.5} />
          SQL Assistant
          <IconChevronDown size={16} stroke={1.5} />
        </span>
        <span class="gaia-chat__actions-end">
          <span class="gaia-chat__pill">🇫🇷 FR <IconChevronDown size={16} stroke={1.5} /></span>
          <span class="gaia-chat__pill gaia-chat__pill--muted">Send</span>
        </span>
      </div>
    </div>
</div>

<style>
  .gaia-chat {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    box-sizing: border-box;
    width: 100%;
    max-width: min(480px, 100%);
    flex-shrink: 0;
    padding: var(--space-32);
    border-radius: var(--radius-xl);
    background: var(--color-base-white);
    box-shadow:
      0 8px 24px rgb(24 2 29 / 0.07),
      0 22px 44px rgb(24 2 29 / 0.09),
      0 0 0 1px rgb(214 194 255 / 0.28),
      0 0 28px rgb(214 194 255 / 0.2),
      0 0 64px rgb(106 22 122 / 0.1);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }

  .gaia-chat:hover {
    transform: translateY(-6px);
    box-shadow:
      0 14px 32px rgb(24 2 29 / 0.1),
      0 28px 56px rgb(24 2 29 / 0.12),
      0 0 0 1px rgb(214 194 255 / 0.4),
      0 0 36px rgb(214 194 255 / 0.3),
      0 0 80px rgb(106 22 122 / 0.14);
  }

  .gaia-chat__toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-bottom: var(--space-16);
    border-bottom: var(--stroke-width) solid var(--color-gray-400);
    color: var(--color-gray-400);
  }

  .gaia-chat__logo {
    display: block;
    width: 23px;
    height: 20px;
    justify-self: start;
  }

  .gaia-chat__toolbar-group {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .gaia-chat__toolbar-group--end {
    justify-self: end;
  }

  .gaia-chat__thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .gaia-chat__message {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .gaia-chat__meta {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .gaia-chat__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-gray-100);
    color: var(--color-gray-600);
  }

  .gaia-chat__author {
    flex: 1;
    color: var(--color-gray-800);
    font-family: var(--font-body);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
  }

  .gaia-chat__time {
    color: var(--color-gray-600);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 300;
    line-height: 1.2;
  }

  .gaia-chat__prompt,
  .gaia-chat__answer {
    margin: 0 0 0 40px;
    color: var(--color-base-black);
    font-family: var(--font-body);
    font-size: 10px;
    line-height: 1.2;
  }

  .gaia-chat__answer {
    font-weight: var(--font-weight-bold);
  }

  .gaia-chat__sql {
    margin: 0 0 0 40px;
    padding: var(--space-16);
    overflow-x: auto;
    border-radius: var(--radius-l);
    background: var(--color-gray-100);
    color: var(--color-gray-800);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: var(--font-weight-regular);
    line-height: 1.45;
    white-space: pre;
  }

  .gaia-chat__kw {
    color: var(--color-primary-500);
  }

  .gaia-chat__composer {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .gaia-chat__placeholder {
    margin: 0;
    padding: var(--space-16);
    border-radius: var(--radius-l);
    background: var(--color-gray-100);
    color: var(--color-gray-500);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
  }

  .gaia-chat__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-10);
  }

  .gaia-chat__actions-end {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gaia-chat__pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border: var(--stroke-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-gray-100);
    color: var(--color-gray-800);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    white-space: nowrap;
  }

  .gaia-chat__pill--muted {
    color: var(--color-gray-400);
  }

  .gaia-chat :global(svg) {
    display: block;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gaia-chat,
    .gaia-chat:hover {
      transform: none;
      transition: box-shadow 0.4s ease;
    }
  }

  @media (max-width: 1024px) {
    .gaia-chat {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .gaia-chat {
      padding: var(--space-24);
    }

    .gaia-chat__sql,
    .gaia-chat__prompt,
    .gaia-chat__answer {
      margin-left: 0;
    }
  }
</style>
