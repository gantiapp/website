---
interface Props {
  strong?: boolean;
}

const { strong = false } = Astro.props;
---

<mark class:list={['highlight', strong && 'highlight--strong']}>
  <span class="highlight__shape" aria-hidden="true"></span>
  <span class="highlight__text"><slot /></span>
</mark>

<style>
  .highlight {
    position: relative;
    display: inline-block;
    color: var(--color-primary-500);
    background: none;
    padding: 0;
    line-height: inherit;
  }

  .highlight__shape {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: -0.1em;
    width: calc(100% + 0.2em);
    height: 1.32em;
    pointer-events: none;
    background: var(--color-primary-50);
    clip-path: polygon(
      0% 8%,
      32% 3%,
      68% 7%,
      100% 4%,
      100% 92%,
      70% 98%,
      34% 94%,
      0% 97%
    );
    transform: translateY(-50%) rotate(-1.1deg);
  }

  .highlight--strong .highlight__shape {
    left: -0.18em;
    width: calc(100% + 0.36em);
    height: 1.4em;
    transform: translateY(-50%) rotate(0.6deg);
  }

  .highlight__text {
    position: relative;
    z-index: 1;
  }

  .highlight--strong .highlight__text {
    font-weight: var(--font-weight-bold);
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 700;
  }
</style>
