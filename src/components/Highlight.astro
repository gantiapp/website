---
interface Props {
  strong?: boolean;
  fill?: string;
  color?: string;
  rotate?: number;
  padX?: number;
  height?: number;
  textPad?: number;
  seed?: 0 | 1 | 2;
}

const {
  strong = false,
  fill,
  color,
  rotate,
  padX,
  height,
  textPad = 0,
  seed = 0,
} = Astro.props;

const clipPaths = [
  'polygon(0% 8%, 32% 3%, 68% 7%, 100% 4%, 100% 92%, 70% 98%, 34% 94%, 0% 97%)',
  'polygon(0% 12%, 28% 4%, 62% 9%, 100% 6%, 98% 90%, 66% 96%, 30% 91%, 2% 95%)',
  'polygon(1% 6%, 38% 9%, 72% 3%, 100% 8%, 99% 94%, 64% 91%, 28% 98%, 0% 93%)',
];

const rotateValue = rotate ?? (strong ? 0.6 : -1.1);
const padXValue = padX ?? (strong ? 0.18 : 0.1);
const heightValue = height ?? (strong ? 1.4 : 1.32);
const clipPath = clipPaths[seed] ?? clipPaths[0];

const highlightStyle = [
  fill ? `--highlight-fill: ${fill}` : '',
  color ? `--highlight-color: ${color}` : '',
  `--highlight-rotate: ${rotateValue}deg`,
  `--highlight-pad-x: ${padXValue}em`,
  `--highlight-height: ${heightValue}em`,
  `--highlight-text-pad: ${textPad}em`,
  `--highlight-clip: ${clipPath}`,
]
  .filter(Boolean)
  .join('; ');
---

<mark class:list={['highlight', strong && 'highlight--strong']} style={highlightStyle}>
  <span class="highlight__shape" aria-hidden="true"></span>
  <span class="highlight__text"><slot /></span>
</mark>

<style>
  .highlight {
    --highlight-fill: var(--color-primary-50);
    --highlight-color: var(--color-primary-500);
    --highlight-rotate: -1.1deg;
    --highlight-pad-x: 0.1em;
    --highlight-height: 1.32em;
    --highlight-text-pad: 0em;
    --highlight-clip: polygon(
      0% 8%,
      32% 3%,
      68% 7%,
      100% 4%,
      100% 92%,
      70% 98%,
      34% 94%,
      0% 97%
    );
    position: relative;
    display: inline-block;
    color: var(--highlight-color);
    background: none;
    padding: 0;
    line-height: inherit;
  }

  .highlight__shape {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: calc(var(--highlight-pad-x) * -1);
    width: calc(100% + var(--highlight-pad-x) * 2);
    height: var(--highlight-height);
    pointer-events: none;
    background: var(--highlight-fill);
    clip-path: var(--highlight-clip);
    transform: translateY(-50%) rotate(var(--highlight-rotate));
  }

  .highlight__text {
    position: relative;
    z-index: 1;
    padding: 0 var(--highlight-text-pad);
  }

  .highlight--strong .highlight__text {
    font-weight: var(--font-weight-bold);
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 700;
  }
</style>
