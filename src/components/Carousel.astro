---
import { IconChevronLeft, IconChevronRight } from '@tabler/icons-astro';

const slides = [
  {
    id: 'observabilite',
    label: 'Observabilité',
    image: '/images/schemas/observabilite.jpg?v=2',
  },
  {
    id: 'cartographie',
    label: 'Cartographie',
    image: '/images/schemas/cartographie.jpg?v=2',
  },
  {
    id: 'referentiel-unique',
    label: 'Référentiel unique',
    image: '/images/schemas/referentiel-unique.jpg?v=2',
  },
  {
    id: 'exploration',
    label: 'Exploration',
    image: '/images/schemas/exploration.jpg?v=2',
  },
  {
    id: 'diagnostic',
    label: 'Diagnostic',
    image: '/images/schemas/diagnostic.jpg?v=2',
  },
];
---

<div class="carousel" data-carousel>
  {
    slides.map((slide) => (
      <link rel="preload" href={slide.image} as="image" />
    ))
  }

  <div class="carousel__nav">
    <button
      class="carousel__arrow"
      type="button"
      aria-label="Schéma précédent"
      data-carousel-prev
    >
      <IconChevronLeft size={24} stroke={2} />
    </button>
    <div class="carousel__tabs" role="tablist" aria-label="Fonctionnalités">
      {
        slides.map((slide, index) => (
          <button
            class="carousel__tab"
            type="button"
            role="tab"
            id={`carousel-tab-${slide.id}`}
            aria-controls={`carousel-panel-${slide.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-carousel-tab
            data-index={String(index)}
          >
            {slide.label}
          </button>
        ))
      }
    </div>
    <button
      class="carousel__arrow"
      type="button"
      aria-label="Schéma suivant"
      data-carousel-next
    >
      <IconChevronRight size={24} stroke={2} />
    </button>
  </div>
  <div class="carousel__dots" role="group" aria-label="Pagination des schémas">
    {
      slides.map((slide, index) => (
        <button
          class:list={['carousel__dot', index === 0 && 'is-active']}
          type="button"
          data-carousel-dot
          data-index={String(index)}
          aria-label={`Afficher ${slide.label}`}
        ></button>
      ))
    }
  </div>

  <div class="carousel__stage">
    {
      slides.map((slide, index) => (
        <div
          class:list={['carousel__slide', index === 0 && 'is-active']}
          id={`carousel-panel-${slide.id}`}
          role="tabpanel"
          aria-labelledby={`carousel-tab-${slide.id}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
          data-carousel-slide
        >
          <img
            class="carousel__image"
            src={slide.image}
            alt=""
            width="2880"
            height="1800"
            loading="eager"
            decoding="async"
          />
        </div>
      ))
    }
  </div>
</div>

<script>
  function setupCarousels() {
    const carousels = document.querySelectorAll('[data-carousel]');
    carousels.forEach((carousel) => {
      const tabs = [...carousel.querySelectorAll('[data-carousel-tab]')];
      const slides = [...carousel.querySelectorAll('[data-carousel-slide]')];
      const dots = [...carousel.querySelectorAll('[data-carousel-dot]')];
      const images = [...carousel.querySelectorAll('.carousel__image')];
      const stage = carousel.querySelector('.carousel__stage');
      const prevButton = carousel.querySelector('[data-carousel-prev]');
      const nextButton = carousel.querySelector('[data-carousel-next]');
      const tablist = carousel.querySelector('[role="tablist"]');
      let currentIndex = 0;
      let touchStartX = 0;
      let touchStartY = 0;

      images.forEach((image) => {
        if (image.decode) {
          image.decode().catch(() => {});
        }
      });

      const show = (nextIndex) => {
        currentIndex = (nextIndex + slides.length) % slides.length;
        tabs.forEach((tab, index) => {
          const isSelected = index === currentIndex;
          tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          tab.setAttribute('tabindex', isSelected ? '0' : '-1');
        });
        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === currentIndex);
        });
        slides.forEach((slide, index) => {
          const isActive = index === currentIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => show(index));
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => show(index));
      });

      prevButton?.addEventListener('click', () => show(currentIndex - 1));
      nextButton?.addEventListener('click', () => show(currentIndex + 1));

      tablist?.addEventListener('keydown', (event) => {
        let nextIndex = currentIndex;
        if (event.key === 'ArrowRight') {
          nextIndex = currentIndex + 1;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = currentIndex - 1;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        show(nextIndex);
        const nextTab = tabs[currentIndex];
        if (nextTab instanceof HTMLElement) {
          nextTab.focus();
        }
      });

      if (stage instanceof HTMLElement) {
        stage.addEventListener(
          'touchstart',
          (event) => {
            touchStartX = event.changedTouches[0].clientX;
            touchStartY = event.changedTouches[0].clientY;
          },
          { passive: true },
        );

        stage.addEventListener(
          'touchend',
          (event) => {
            const deltaX = event.changedTouches[0].clientX - touchStartX;
            const deltaY = event.changedTouches[0].clientY - touchStartY;
            if (Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY)) {
              return;
            }
            show(currentIndex + (deltaX < 0 ? 1 : -1));
          },
          { passive: true },
        );
      }
    });
  }

  setupCarousels();
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    width: 100%;
    box-sizing: border-box;
    padding: 0;
  }

  .carousel__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: var(--space-12);
  }

  .carousel__arrow {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: var(--stroke-width) solid var(--color-primary-100);
    border-radius: var(--radius-pill);
    background: var(--color-base-white);
    color: var(--color-primary-500);
    cursor: pointer;
  }

  .carousel__arrow:hover,
  .carousel__arrow:focus-visible {
    background: var(--color-primary-50);
  }

  .carousel__arrow :global(svg) {
    display: block;
  }

  .carousel__tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
  }

  .carousel__dots {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .carousel__dot {
    width: 32px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-primary-100);
    cursor: pointer;
  }

  .carousel__dot.is-active {
    background: var(--color-primary-500);
  }

  .carousel__tab {
    padding: var(--space-16);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-gray-400);
    font-family: var(--font-body);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
  }

  .carousel__tab:hover,
  .carousel__tab:focus-visible {
    color: var(--color-primary-500);
  }

  .carousel__tab[aria-selected='true'] {
    background: var(--color-primary-50);
    color: var(--color-primary-500);
  }

  .carousel__stage {
    position: relative;
    width: 1100px;
    max-width: 100%;
    aspect-ratio: 1440 / 900;
  }

  .carousel__slide {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
  }

  .carousel__slide.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  .carousel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-2xl);
  }

  @media (max-width: 768px) {
    .carousel__nav {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr) 40px;
      column-gap: var(--space-12);
    }

    .carousel__arrow {
      display: inline-flex;
    }

    .carousel__tabs {
      flex-wrap: nowrap;
      justify-content: center;
      gap: 0;
      min-width: 0;
      overflow: hidden;
    }

    .carousel__tab {
      display: none;
      font-size: var(--font-size-body);
    }

    .carousel__tab[aria-selected='true'] {
      display: block;
    }

    .carousel__dots {
      display: flex;
    }

    .carousel__stage {
      width: calc(100% + 2 * var(--space-page) - 24px);
      max-width: none;
      margin-inline: calc(12px - var(--space-page));
    }

    .carousel__image {
      border-radius: var(--radius-m);
    }
  }
</style>
