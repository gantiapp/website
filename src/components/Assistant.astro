---
import { IconChevronRight } from '@tabler/icons-astro';
import SectionHeading from './SectionHeading.astro';
import GaiaChat from './GaiaChat.astro';

const steps = [
  {
    label: 'Vos règles métier. Des contrôles concrets.',
    href: '/ia#regles-metier',
  },
  {
    label: 'Des anomalies. Et surtout, des réponses.',
    href: '/ia#anomalies',
  },
  {
    label: 'Votre intelligence. Dans votre environnement.',
    href: '/ia#environnement',
  },
];
---

<section class="assistant" data-assistant>
  <div class="assistant__glow" aria-hidden="true"></div>
  <div class="assistant__inner">
    <div class="assistant__copy">
      <SectionHeading subtitle="Un copilote intelligent vous accompagne tout au long du processus, de la création à l’analyse.">
        Un assistant qui vous<br class="break-desktop" /> accompagne à chaque étape
      </SectionHeading>

      <div class="assistant__details">
        <ol class="assistant__steps">
          {
            steps.map((step, index) => (
              <li>
                <a class="assistant__step" href={step.href}>
                  <span class="assistant__index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="assistant__step-label">{step.label}</span>
                  <span class="assistant__step-arrow" aria-hidden="true">
                    <IconChevronRight size={18} stroke={1.75} />
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="assistant__chat">
      <GaiaChat />
    </div>
  </div>
</section>

<script>
  function setupAssistantGlow() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    if (reduceMotion || !finePointer) {
      return;
    }

    const sections = document.querySelectorAll('[data-assistant]');
    sections.forEach((section) => {
      if (!(section instanceof HTMLElement)) {
        return;
      }

      let animationFrame = 0;
      let targetX = 0.72;
      let targetY = 0.42;
      let currentX = 0.72;
      let currentY = 0.42;

      const render = () => {
        currentX += (targetX - currentX) * 0.16;
        currentY += (targetY - currentY) * 0.16;
        section.style.setProperty('--glow-x', `${(currentX * 100).toFixed(2)}%`);
        section.style.setProperty('--glow-y', `${(currentY * 100).toFixed(2)}%`);
        const stillMoving =
          Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001;
        animationFrame = stillMoving ? requestAnimationFrame(render) : 0;
      };

      section.addEventListener('mousemove', (event) => {
        const bounds = section.getBoundingClientRect();
        targetX = (event.clientX - bounds.left) / bounds.width;
        targetY = (event.clientY - bounds.top) / bounds.height;
        section.classList.add('is-glowing');
        if (!animationFrame) {
          animationFrame = requestAnimationFrame(render);
        }
      });

      section.addEventListener('mouseleave', () => {
        section.classList.remove('is-glowing');
      });
    });
  }

  setupAssistantGlow();
</script>

<style>
  .assistant {
    --glow-x: 72%;
    --glow-y: 42%;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-base-white);
    padding: var(--space-section-y) var(--space-page);
  }

  .assistant__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      820px circle at var(--glow-x) var(--glow-y),
      rgb(214 194 255 / 0.22) 0%,
      rgb(238 225 241 / 0.1) 42%,
      transparent 74%
    );
    filter: blur(28px);
    transition: opacity 0.6s ease;
  }

  .assistant.is-glowing .assistant__glow {
    opacity: 1;
  }

  .assistant__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(var(--space-64), 6vw, var(--space-128));
    max-width: 1408px;
    margin: 0 auto;
  }

  .assistant__chat {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    max-width: min(480px, 100%);
    animation: assistant-float 6s ease-in-out infinite;
  }

  .assistant__chat::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 12% -8%;
    border-radius: 48%;
    background: radial-gradient(circle, rgb(214 194 255 / 0.32) 0%, transparent 72%);
    filter: blur(36px);
    pointer-events: none;
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .assistant__chat:hover::before {
    opacity: 0.85;
    filter: blur(28px);
    background: radial-gradient(circle, rgb(214 194 255 / 0.42) 0%, transparent 72%);
  }

  @keyframes assistant-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .assistant__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-48);
    min-width: 0;
    max-width: 800px;
  }

  .assistant__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .assistant__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .assistant__step {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    width: fit-content;
    max-width: 100%;
    padding: var(--space-4) var(--space-12) var(--space-4) var(--space-4);
    border-radius: var(--radius-l);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .assistant__step:hover,
  .assistant__step:focus-visible {
    background: var(--color-primary-50);
  }

  .assistant__step:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .assistant__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: var(--radius-s);
    background: var(--color-primary-500);
    color: var(--color-primary-50);
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-bold);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 700;
    line-height: 1;
  }

  .assistant__step-label {
    color: var(--color-primary-800);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-heading);
  }

  .assistant__step:hover .assistant__step-label,
  .assistant__step:focus-visible .assistant__step-label {
    color: var(--color-primary-600);
  }

  .assistant__step-arrow {
    display: flex;
    flex-shrink: 0;
    color: var(--color-primary-500);
    opacity: 0.55;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .assistant__step:hover .assistant__step-arrow,
  .assistant__step:focus-visible .assistant__step-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .assistant__step-arrow :global(svg) {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .assistant__glow {
      display: none;
    }

    .assistant__chat {
      animation: none;
    }

    .assistant__step-arrow {
      transition: none;
    }
  }

  @media (max-width: 1280px) {
    .assistant__inner {
      gap: var(--space-64);
    }
  }

  @media (max-width: 1024px) {
    .assistant__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-48);
    }

    .assistant__copy {
      max-width: none;
    }

    .assistant__chat {
      max-width: none;
    }
  }

  @media (max-width: 768px) {
    .assistant__copy {
      gap: var(--space-32);
    }
  }
</style>
