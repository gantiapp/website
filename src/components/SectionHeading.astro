---
interface Props {
  subtitle?: string;
  headingLevel?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
}

const { subtitle, headingLevel = 'h2', align = 'left' } = Astro.props;
const HeadingTag = headingLevel;
---

<div class:list={['section-heading', align === 'center' && 'section-heading--center']}>
  <HeadingTag class="section-heading__title">
    <slot />
  </HeadingTag>
  {
    subtitle && (
      <p class="section-heading__subtitle">{subtitle}</p>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
  }

  .section-heading--center {
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  .section-heading__title {
    margin: 0;
    color: var(--color-primary-800);
    font-family: var(--font-display);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-extrabold);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 800;
    letter-spacing: 0;
    line-height: var(--line-height-heading);
  }

  .section-heading__subtitle {
    margin: 0;
    max-width: 658px;
    color: var(--color-primary-800);
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-body);
  }

  .section-heading--center .section-heading__subtitle {
    max-width: none;
    font-size: var(--font-size-subtitle);
    line-height: var(--line-height-heading);
  }

  @media (max-width: 1024px) {
    .section-heading__title {
      font-size: var(--font-size-h2);
    }

    .section-heading--center .section-heading__subtitle {
      font-size: var(--font-size-body-large);
    }
  }
</style>
