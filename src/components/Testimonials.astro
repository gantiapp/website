---
import { IconChevronLeft, IconChevronRight } from '@tabler/icons-astro';
import Clients from './Clients.astro';
import SectionHeading from './SectionHeading.astro';
import TestimonialCard from './TestimonialCard.astro';
import testimonials from '../data/testimonials.json';
---

<section class="testimonials" data-testimonials aria-label="Ce que disent nos clients">
  <div class="testimonials__intro">
    <div class="testimonials__heading">
      <SectionHeading
        align="center"
        subtitle="Des résultats concrets pour les leaders de la data"
      >
        Ce que disent nos clients
      </SectionHeading>
    </div>
    <Clients />
  </div>

  <div class="testimonials__viewport" data-testimonials-viewport>
    <div class="testimonials__track" data-testimonials-track>
      {
        testimonials.map((testimonial, index) => (
          <div
            class:list={['testimonials__slide', index === 0 && 'is-current']}
            data-testimonials-slide
            data-source-index={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <TestimonialCard
              name={testimonial.name}
              role={testimonial.role}
              company={testimonial.company}
              domain={testimonial.domain}
              quote={testimonial.quote}
              rating={testimonial.rating}
              logo={testimonial.logo}
              featured={index === 0}
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="testimonials__controls">
    <button
      class="testimonials__arrow"
      type="button"
      data-testimonials-prev
      aria-label="Témoignage précédent"
    >
      <IconChevronLeft size={24} stroke={2} />
    </button>
    <div class="testimonials__dots" role="tablist" aria-label="Pagination des témoignages">
      {
        testimonials.map((testimonial, index) => (
          <button
            class:list={['testimonials__dot', index === 0 && 'is-active']}
            type="button"
            role="tab"
            data-testimonials-dot
            aria-label={`Afficher le témoignage de ${testimonial.name}`}
            aria-current={index === 0 ? 'true' : undefined}
          />
        ))
      }
    </div>
    <button
      class="testimonials__arrow"
      type="button"
      data-testimonials-next
      aria-label="Témoignage suivant"
    >
      <IconChevronRight size={24} stroke={2} />
    </button>
  </div>
</section>

<script>
  function setupTestimonials() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sections = document.querySelectorAll('[data-testimonials]');

    sections.forEach((section) => {
      const viewport = section.querySelector('[data-testimonials-viewport]');
      const track = section.querySelector('[data-testimonials-track]');
      const dots = [...section.querySelectorAll('[data-testimonials-dot]')];
      const prevButton = section.querySelector('[data-testimonials-prev]');
      const nextButton = section.querySelector('[data-testimonials-next]');

      if (!(viewport instanceof HTMLElement) || !(track instanceof HTMLElement)) {
        return;
      }

      const markClone = (node) => {
        if (!(node instanceof HTMLElement)) {
          return null;
        }
        node.setAttribute('data-clone', 'true');
        node.classList.remove('is-current');
        node.setAttribute('aria-hidden', 'true');
        node.querySelector('.testimonial-card')?.classList.remove('is-featured');
        return node;
      };

      if (!track.querySelector('[data-clone]')) {
        const originalSlides = [...track.querySelectorAll('[data-testimonials-slide]')];
        const prefixFragment = document.createDocumentFragment();
        const suffixFragment = document.createDocumentFragment();
        originalSlides.forEach((slide) => {
          const prefixClone = markClone(slide.cloneNode(true));
          const suffixClone = markClone(slide.cloneNode(true));
          if (prefixClone) {
            prefixFragment.append(prefixClone);
          }
          if (suffixClone) {
            suffixFragment.append(suffixClone);
          }
        });
        track.prepend(prefixFragment);
        track.append(suffixFragment);
      }

      const realSlides = [...track.querySelectorAll('[data-testimonials-slide]:not([data-clone])')];
      const realCount = realSlides.length;
      if (realCount === 0) {
        return;
      }

      const slides = [...track.querySelectorAll('[data-testimonials-slide]')];
      const lastLoopIndex = slides.length - 1;
      const dragStartThreshold = 12;
      const snapThreshold = 80;
      const motionDurationMs = 480;
      let currentIndex = realCount;
      let currentTranslateX = 0;
      let motionToken = 0;
      let activePointerId = null;
      let dragOriginX = 0;
      let dragOriginY = 0;
      let dragStartTranslateX = 0;
      let dragStartIndex = realCount;
      let isDragging = false;
      let skipClick = false;

      if (reduceMotion) {
        section.classList.add('is-static');
      }

      const slideMetrics = () => {
        const firstSlide = slides[0];
        const slideWidth =
          firstSlide instanceof HTMLElement ? firstSlide.offsetWidth : 768;
        const trackStyles = window.getComputedStyle(track);
        const gapValue = Number.parseFloat(trackStyles.columnGap || trackStyles.gap) || 32;
        return {
          width: slideWidth,
          gap: gapValue,
          step: slideWidth + gapValue,
        };
      };

      const offsetForIndex = (index) => {
        const { width, step } = slideMetrics();
        const slideCenter = index * step + width / 2;
        return viewport.offsetWidth / 2 - slideCenter;
      };

      const clampLoopIndex = (index) =>
        Math.min(lastLoopIndex - 1, Math.max(1, index));

      const nearestIndexFromOffset = (translateX) => {
        const { width, step } = slideMetrics();
        const rawIndex = (viewport.offsetWidth / 2 - width / 2 - translateX) / step;
        return clampLoopIndex(Math.round(rawIndex));
      };

      const realIndexFromLoop = (index) =>
        ((index % realCount) + realCount) % realCount;

      const applyTranslate = (translateX, withMotion) => {
        currentTranslateX = translateX;
        if (withMotion && !reduceMotion) {
          track.style.transition = `transform ${motionDurationMs}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        } else {
          track.getAnimations().forEach((animation) => animation.cancel());
          track.style.transition = 'none';
        }
        track.style.transform = `translate3d(${translateX}px, 0, 0)`;
      };

      const updateActiveSlide = (index) => {
        slides.forEach((slide, slideIndex) => {
          const isCurrent = slideIndex === index;
          slide.classList.toggle('is-current', isCurrent);
          slide.setAttribute('aria-hidden', isCurrent ? 'false' : 'true');
          slide.querySelector('.testimonial-card')?.classList.toggle('is-featured', isCurrent);
        });
        const activeRealIndex = realIndexFromLoop(index);
        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeRealIndex;
          dot.classList.toggle('is-active', isActive);
          if (isActive) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      };

      const snapToRealSet = (index) => {
        if (index < realCount) {
          return index + realCount;
        }
        if (index >= realCount * 2) {
          return index - realCount;
        }
        return index;
      };

      const settleToIndex = (index, { instant = false } = {}) => {
        const token = ++motionToken;
        currentIndex = index;
        updateActiveSlide(index);
        applyTranslate(offsetForIndex(index), !instant);

        const finishMotion = () => {
          if (token !== motionToken) {
            return;
          }
          const snappedIndex = snapToRealSet(currentIndex);
          if (snappedIndex === currentIndex) {
            return;
          }
          currentIndex = snappedIndex;
          updateActiveSlide(currentIndex);
          applyTranslate(offsetForIndex(currentIndex), false);
        };

        if (instant || reduceMotion) {
          finishMotion();
          return;
        }

        window.setTimeout(finishMotion, motionDurationMs);
      };

      const goToLoopIndex = (index) => {
        settleToIndex(clampLoopIndex(index));
      };

      const goToRealIndex = (targetRealIndex) => {
        const currentRealIndex = realIndexFromLoop(currentIndex);
        let delta = targetRealIndex - currentRealIndex;
        const wrappedDelta = delta > 0 ? delta - realCount : delta + realCount;
        if (Math.abs(wrappedDelta) < Math.abs(delta)) {
          delta = wrappedDelta;
        }
        goToLoopIndex(currentIndex + delta);
      };

      const endPointer = (event) => {
        if (activePointerId !== event.pointerId) {
          return;
        }

        try {
          if (viewport.hasPointerCapture(event.pointerId)) {
            viewport.releasePointerCapture(event.pointerId);
          }
        } catch {
          // Capture is optional when the pointer never entered dragging.
        }

        section.classList.remove('is-dragging');
        activePointerId = null;

        if (isDragging) {
          skipClick = true;
          const draggedDistance = currentTranslateX - dragStartTranslateX;
          if (Math.abs(draggedDistance) < snapThreshold) {
            settleToIndex(dragStartIndex);
          } else {
            goToLoopIndex(nearestIndexFromOffset(currentTranslateX));
          }
        }

        isDragging = false;
      };

      viewport.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Element && event.target.closest('button')) {
          return;
        }
        if (event.pointerType === 'mouse' && event.button !== 0) {
          return;
        }
        activePointerId = event.pointerId;
        dragOriginX = event.clientX;
        dragOriginY = event.clientY;
        dragStartTranslateX = currentTranslateX;
        dragStartIndex = currentIndex;
        isDragging = false;
      });

      viewport.addEventListener('pointermove', (event) => {
        if (activePointerId !== event.pointerId) {
          return;
        }
        const offsetX = event.clientX - dragOriginX;
        const offsetY = event.clientY - dragOriginY;
        if (!isDragging) {
          if (Math.abs(offsetX) < dragStartThreshold && Math.abs(offsetY) < dragStartThreshold) {
            return;
          }
          if (Math.abs(offsetY) >= Math.abs(offsetX)) {
            activePointerId = null;
            return;
          }
          isDragging = true;
          motionToken += 1;
          section.classList.add('is-dragging');
          try {
            viewport.setPointerCapture(event.pointerId);
          } catch {
            // Continue dragging from viewport events if capture is unavailable.
          }
        }
        applyTranslate(dragStartTranslateX + offsetX, false);
        updateActiveSlide(nearestIndexFromOffset(currentTranslateX));
      });

      viewport.addEventListener('pointerup', endPointer);
      viewport.addEventListener('pointercancel', endPointer);

      viewport.addEventListener('click', (event) => {
        if (!skipClick) {
          return;
        }
        event.preventDefault();
        event.stopPropagation();
        skipClick = false;
      }, true);

      prevButton?.addEventListener('click', () => goToLoopIndex(currentIndex - 1));
      nextButton?.addEventListener('click', () => goToLoopIndex(currentIndex + 1));
      dots.forEach((dot, realIndex) => {
        dot.addEventListener('click', () => goToRealIndex(realIndex));
      });

      window.addEventListener('resize', () => {
        applyTranslate(offsetForIndex(currentIndex), false);
      });

      applyTranslate(offsetForIndex(currentIndex), false);
      updateActiveSlide(currentIndex);
      section.classList.add('is-ready');
    });
  }

  setupTestimonials();
</script>

<style>
  .testimonials {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
    padding: var(--space-section-y) 0;
    background: var(--color-bg-muted);
  }

  .testimonials__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  .testimonials__heading {
    padding: 0 var(--space-page);
  }

  .testimonials__heading :global(.section-heading) {
    align-items: center;
    text-align: center;
  }

  .testimonials__heading :global(.section-heading__subtitle) {
    max-width: none;
    font-size: var(--font-size-subtitle);
    line-height: var(--line-height-heading);
  }

  .testimonials__viewport {
    overflow: hidden;
    width: 100%;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    visibility: hidden;
  }

  .testimonials.is-ready .testimonials__viewport {
    visibility: visible;
  }

  .testimonials.is-dragging .testimonials__viewport {
    cursor: grabbing;
  }

  .testimonials__track {
    display: flex;
    align-items: stretch;
    gap: var(--space-32);
    will-change: transform;
  }

  .testimonials.is-dragging .testimonials__track,
  .testimonials.is-dragging .testimonials__slide {
    transition: none;
  }

  .testimonials__slide {
    box-sizing: border-box;
    flex: 0 0 min(768px, calc(100vw - 48px));
    width: min(768px, calc(100vw - 48px));
    opacity: 0.45;
  }

  .testimonials__slide.is-current {
    opacity: 1;
    z-index: 1;
  }

  .testimonials:not(.is-static) .testimonials__slide {
    transition: opacity 0.45s ease;
  }

  .testimonials__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-24);
  }

  .testimonials__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: var(--stroke-width) solid var(--color-primary-100);
    border-radius: var(--radius-pill);
    background: var(--color-base-white);
    color: var(--color-primary-500);
    cursor: pointer;
  }

  .testimonials__arrow:hover,
  .testimonials__arrow:focus-visible {
    background: var(--color-primary-50);
  }

  .testimonials__dots {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .testimonials__dot {
    width: 32px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-primary-100);
    cursor: pointer;
  }

  .testimonials__dot.is-active {
    background: var(--color-primary-500);
  }

  @media (max-width: 768px) {
    .testimonials {
      gap: var(--space-48);
    }

    .testimonials__intro {
      gap: var(--space-32);
    }
  }
</style>
