---
import CharacterDock from './CharacterDock.astro';
import Highlight from './Highlight.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  impact: string;
  useCase: string;
  side: 'left' | 'right';
  tone: string;
  characterSrc: string;
  characterAlt: string;
}

const {
  id,
  title,
  description,
  impact,
  useCase,
  side,
  tone,
  characterSrc,
  characterAlt,
} = Astro.props;

const highlightFills = {
  query: 'color-mix(in srgb, var(--color-module-query-manager) 52%, white)',
  bridge: 'color-mix(in srgb, var(--color-module-bridge-query-manager) 62%, white)',
  data: 'color-mix(in srgb, var(--color-module-data-manager) 48%, white)',
  command: 'color-mix(in srgb, var(--color-module-command-manager) 50%, white)',
};

const highlightFill = highlightFills[tone] ?? 'var(--module-highlight)';
---

<section
  class:list={['product-stage', `product-stage--${tone}`, `product-stage--${side}`]}
  id={id}
  data-product-stage
>
  <div class="product-stage__copy">
    <div class="product-stage__intro">
      <h2 class="product-stage__title">{title}</h2>
      <p class="product-stage__description">{description}</p>
    </div>
    <div class="product-stage__points">
      <div class="product-stage__point">
        <h3 class="product-stage__label">
          <Highlight
            fill={highlightFill}
            color="currentColor"
            rotate={-0.85}
            padX={0.34}
            height={1.52}
            textPad={0.22}
            seed={1}
          >
            Impact
          </Highlight>
        </h3>
        <p class="product-stage__text">{impact}</p>
      </div>
      <div class="product-stage__point">
        <h3 class="product-stage__label">
          <Highlight
            fill={highlightFill}
            color="currentColor"
            rotate={1.05}
            padX={0.38}
            height={1.56}
            textPad={0.24}
            seed={2}
          >
            Use case
          </Highlight>
        </h3>
        <p class="product-stage__text">{useCase}</p>
      </div>
    </div>
  </div>
  <img
    class="product-stage__character"
    src={characterSrc}
    alt={characterAlt}
    width="642"
    height="768"
  />
  <CharacterDock currentId={id} />
</section>

<style>
  .product-stage {
    --module-highlight: color-mix(in srgb, var(--module-accent) 28%, white);
    --stage-title-size: clamp(var(--font-size-h1), 2.5vw, 999px);
    --stage-body-size: clamp(var(--font-size-subtitle), 1.25vw, 999px);
    --stage-label-size: clamp(var(--font-size-h3), 1.55vw, 999px);
    --stage-copy-gap: clamp(var(--space-32), 4vw, 999px);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    min-height: 100svh;
    padding: clamp(24px, 6svh, 8vw) clamp(var(--space-page), 6vw, 10vw) 0;
    overflow: visible;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: var(--module-bg);
    color: var(--module-accent);
  }

  .product-stage--query {
    --module-bg: var(--color-module-query-bg);
    --module-accent: var(--color-module-query-accent);
    --module-highlight: var(--color-module-query-manager);
  }

  .product-stage--bridge {
    --module-bg: var(--color-module-bridge-bg);
    --module-accent: var(--color-module-bridge-accent);
    --module-highlight: var(--color-module-bridge-query-manager);
  }

  .product-stage--data {
    --module-bg: var(--color-module-data-bg);
    --module-accent: var(--color-module-data-accent);
    --module-highlight: var(--color-module-data-manager);
  }

  .product-stage--command {
    --module-bg: var(--color-module-command-bg);
    --module-accent: var(--color-module-command-accent);
    --module-highlight: var(--color-module-command-manager);
  }

  .product-stage__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--stage-copy-gap);
    max-width: 52vw;
    margin-block: auto;
  }

  .product-stage--left .product-stage__copy {
    margin-left: max(26vw, 12rem);
  }

  .product-stage--right .product-stage__copy {
    margin-right: max(8vw, 4rem);
  }

  .product-stage__intro,
  .product-stage__points,
  .product-stage__point {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .product-stage__points {
    gap: clamp(var(--space-24), 3vw, 999px);
    max-width: none;
  }

  .product-stage__title {
    margin: 0;
    color: var(--module-accent);
    font-family: var(--font-display);
    font-size: var(--stage-title-size);
    font-weight: var(--font-weight-extrabold);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 800;
    letter-spacing: 0;
    line-height: var(--line-height-heading);
  }

  .product-stage__description,
  .product-stage__text {
    margin: 0;
    color: var(--color-base-black);
    font-family: var(--font-body);
    font-size: var(--stage-body-size);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-heading);
  }

  .product-stage__label {
    margin: 0;
    color: var(--module-accent);
    font-family: var(--font-display);
    font-size: var(--stage-label-size);
    font-weight: var(--font-weight-medium);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 500;
    letter-spacing: 0;
    line-height: var(--line-height-heading);
  }

  .product-stage__character {
    position: absolute;
    z-index: 0;
    bottom: 0;
    width: auto;
    height: 34vw;
    max-height: 78%;
    max-width: none;
    pointer-events: none;
    object-fit: contain;
  }

  .product-stage--left .product-stage__character {
    left: -8%;
  }

  .product-stage--right .product-stage__character {
    right: -7%;
  }

  @media (max-width: 1440px) {
    .product-stage {
      --stage-title-size: var(--font-size-h2);
      --stage-body-size: var(--font-size-body-large);
      --stage-label-size: var(--font-size-body-large);
      --stage-copy-gap: var(--space-64);
      padding: min(var(--space-64), 6svh) var(--space-page) 0;
    }

    .product-stage__copy {
      max-width: min(58vw, 900px);
    }

    .product-stage--left .product-stage__copy {
      margin-left: clamp(0px, 12vw, 180px);
    }

    .product-stage__character {
      height: min(52svh, 34vw);
    }
  }

  @media (max-height: 800px) and (min-width: 1025px) {
    .product-stage {
      padding-top: var(--space-32);
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }

    .product-stage__copy {
      gap: var(--space-32);
    }

    .product-stage__points {
      gap: var(--space-24);
    }

    .product-stage__character {
      height: min(48svh, 30vw);
    }
  }

  @media (max-width: 1024px) {
    .product-stage {
      justify-content: flex-start;
      gap: var(--space-32);
      min-height: auto;
      padding: var(--space-48) var(--space-page) 0;
      overflow: visible;
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }

    .product-stage__copy {
      max-width: none;
      gap: var(--space-32);
      margin-left: 0;
      margin-right: 0;
      margin-block: 0;
    }

    .product-stage__points {
      gap: var(--space-32);
      max-width: none;
    }

    .product-stage__character {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      align-self: center;
      height: 220px;
      max-width: 80%;
    }

    .product-stage--left .product-stage__character,
    .product-stage--right .product-stage__character {
      left: auto;
      right: auto;
    }
  }

  @media (max-width: 480px) {
    .product-stage__character {
      height: 180px;
    }
  }
</style>
