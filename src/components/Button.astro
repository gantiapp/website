---
import { IconArrowUpRight } from '@tabler/icons-astro';

interface Props {
  href: string;
  variant?: 'primary' | 'module' | 'inverse' | 'inverse-outline';
  hideIcon?: boolean;
}

const { href, variant = 'primary', hideIcon = false } = Astro.props;
const iconAtStart = variant === 'inverse';
---

<a
  class:list={[
    'button',
    variant === 'primary' && 'button--primary',
    variant === 'module' && 'button--module',
    variant === 'inverse' && 'button--inverse',
    variant === 'inverse-outline' && 'button--inverse-outline',
  ]}
  href={href}
>
  {
    !hideIcon && iconAtStart ? (
      <span class="button__icon">
        <slot name="icon">
          <IconArrowUpRight size={20} stroke={1.5} />
        </slot>
      </span>
    ) : null
  }
  <span class="button__label"><slot /></span>
  {
    !hideIcon && !iconAtStart ? (
      <span class="button__icon">
        <IconArrowUpRight size={20} stroke={1.5} />
      </span>
    ) : null
  }
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: max-content;
    gap: var(--space-8);
    padding: var(--space-16);
    border: none;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  .button--primary {
    background: var(--color-action);
    color: var(--color-primary-50);
  }

  .button--primary:hover,
  .button--primary:focus-visible {
    background: var(--color-primary-600);
  }

  .button--module {
    align-self: stretch;
    width: 100%;
    background: var(--button-bg);
    color: var(--button-fg);
  }

  .button--module:hover,
  .button--module:focus-visible {
    filter: brightness(0.92);
  }

  .button--inverse {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .button--inverse:hover,
  .button--inverse:focus-visible {
    background: var(--color-primary-100);
  }

  .button--inverse-outline {
    background: rgb(255 255 255 / 0.1);
    color: var(--color-primary-50);
    border: 1.5px solid var(--color-primary-50);
  }

  .button--inverse-outline:hover,
  .button--inverse-outline:focus-visible {
    background: rgb(255 255 255 / 0.18);
  }

  .button__icon {
    display: flex;
    flex-shrink: 0;
  }

  .button__label {
    white-space: nowrap;
  }

  .button :global(svg) {
    display: block;
    flex-shrink: 0;
  }
</style>
