---
import { IconArrowUpRight } from '@tabler/icons-astro';

interface Props {
  href: string;
  variant?: 'primary' | 'module';
}

const { href, variant = 'primary' } = Astro.props;
---

<a
  class:list={[
    'button',
    variant === 'primary' && 'button--primary',
    variant === 'module' && 'button--module',
  ]}
  href={href}
>
  <span class="button__label"><slot /></span>
  <IconArrowUpRight size={20} stroke={1.5} />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: max-content;
    gap: var(--space-8);
    padding: var(--space-16);
    border: none;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  .button--primary {
    background: var(--color-action);
    color: var(--color-primary-50);
  }

  .button--primary:hover,
  .button--primary:focus-visible {
    background: var(--color-primary-600);
  }

  .button--module {
    align-self: stretch;
    width: 100%;
    background: var(--button-bg);
    color: var(--button-fg);
  }

  .button--module:hover,
  .button--module:focus-visible {
    filter: brightness(0.92);
  }

  .button__label {
    white-space: nowrap;
  }

  .button :global(svg) {
    display: block;
    flex-shrink: 0;
  }
</style>
