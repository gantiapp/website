---
type Connector = {
  name: string;
  slug: string;
  src?: string;
};

const connectors: Connector[] = [
  { name: 'PostgreSQL', slug: 'postgresql', src: '/images/logos-connectors/postgresql.png' },
  { name: 'MySQL', slug: 'mysql', src: '/images/logos-connectors/mysql.png' },
  { name: 'Oracle', slug: 'oracle', src: '/images/logos-connectors/oracle.png' },
  { name: 'Snowflake', slug: 'snowflake', src: '/images/logos-connectors/snowflake.png' },
  { name: 'MongoDB', slug: 'mongodb', src: '/images/logos-connectors/mongodb.png' },
  { name: 'IBM DB2', slug: 'ibm-db2', src: '/images/logos-connectors/ibm-db2.png' },
  { name: 'AS/400', slug: 'as400', src: '/images/logos-connectors/as400.png' },
  { name: 'BigQuery', slug: 'bigquery', src: '/images/logos-connectors/bigquery.png' },
  { name: 'SQL Server', slug: 'sql-server', src: '/images/logos-connectors/sql-server.png' },
  { name: 'Google Sheets', slug: 'google-sheets', src: '/images/logos-connectors/google-sheets.png' },
];

const stackTags = ['Relationnel', 'NoSQL', 'Entrepôt', 'Tableur'];
const orbitRadius = 34;
const nameDistance = 92;

const connectorNodes = connectors.map((connector, index) => {
  const angleDegrees = (index / connectors.length) * 360 - 90;
  const angleRadians = angleDegrees * (Math.PI / 180);
  const x = 50 + Math.cos(angleRadians) * orbitRadius;
  const y = 50 + Math.sin(angleRadians) * orbitRadius;

  return {
    ...connector,
    angle: `${angleDegrees.toFixed(2)}deg`,
    hasSatellite: index % 2 === 0,
    left: `${x.toFixed(2)}%`,
    top: `${y.toFixed(2)}%`,
    nameX: `${(Math.cos(angleRadians) * nameDistance).toFixed(1)}px`,
    nameY: `${(Math.sin(angleRadians) * nameDistance).toFixed(1)}px`,
    delay: `${(index * 0.18).toFixed(2)}s`,
  };
});
---

<section class="connectors" aria-label="10 connecteurs natifs">
  <div class="connectors__inner">
    <div class="connectors__copy">
      <p class="connectors__count" aria-hidden="true">10</p>
      <h2 class="connectors__title">
        <span class="visually-hidden">10 </span>connecteurs natifs
      </h2>
      <p class="connectors__subtitle">
        Relationnel, NoSQL, entrepôts et tableurs. Un seul point d’entrée,
        sans projet d’intégration de six mois.
      </p>
      <ul class="connectors__tags">
        {
          stackTags.map((tag) => (
            <li class="connectors__tag">{tag}</li>
          ))
        }
      </ul>
    </div>

    <div class="connectors__stage">
      <div class="connectors__chart" aria-hidden="true">
        <span class="connectors__ring connectors__ring--inner"></span>
        <span class="connectors__ring connectors__ring--mid"></span>
        <span class="connectors__ring connectors__ring--orbit"></span>
        <span class="connectors__ring connectors__ring--field"></span>
        <span class="connectors__ring connectors__ring--wide"></span>
        <span class="connectors__ring connectors__ring--horizon"></span>
        <ul class="connectors__spokes">
          {
            connectorNodes.map((node) => (
              <li
                class:list={[
                  'connectors__spoke',
                  node.hasSatellite && 'connectors__spoke--satellite',
                ]}
                style={`--angle: ${node.angle}`}
              ></li>
            ))
          }
        </ul>
      </div>

      <div class="connectors__hub" aria-hidden="true">
        <img src="/images/ganti/ganti.svg" alt="" width="91" height="31" />
      </div>

      <ul class="connectors__orbit">
        {
          connectorNodes.map((node) => (
            <li
              class="connectors__node"
              style={`--left: ${node.left}; --top: ${node.top}; --name-x: ${node.nameX}; --name-y: ${node.nameY}; --delay: ${node.delay}`}
            >
              <article class="connectors__disc" data-connector={node.slug}>
                {node.src ? (
                  <img src={node.src} alt="" width="64" height="64" />
                ) : (
                  <span class="connectors__socket" aria-hidden="true">
                    <span class="connectors__socket-ring"></span>
                    <span class="connectors__socket-core"></span>
                  </span>
                )}
              </article>
              <p class="connectors__name">{node.name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .connectors {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg-muted);
    padding: var(--space-section-y) var(--space-page);
  }

  .connectors.is-paused .connectors__node,
  .connectors.is-paused .connectors__ring--orbit,
  .connectors.is-paused .connectors__ring--horizon,
  .connectors.is-paused .connectors__hub::after {
    animation-play-state: paused;
  }

  .connectors__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(var(--space-48), 5vw, var(--space-96));
    max-width: 1408px;
    margin: 0 auto;
  }

  .connectors__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    max-width: 480px;
    min-width: 0;
  }

  .connectors__count {
    margin: 0;
    color: var(--color-primary-800);
    font-family: var(--font-display);
    font-size: calc(var(--font-size-display) * 1.75);
    font-weight: var(--font-weight-extrabold);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }

  .connectors__title {
    margin: 0;
    color: var(--color-primary-800);
    font-family: var(--font-display);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-extrabold);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 800;
    letter-spacing: 0;
    line-height: var(--line-height-heading);
  }

  .connectors__subtitle {
    margin: 0;
    max-width: 28em;
    color: var(--color-primary-800);
    font-family: var(--font-body);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-body);
  }

  .connectors__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .connectors__tag {
    padding: var(--space-8) var(--space-16);
    border: var(--stroke-width) solid var(--color-primary-200);
    border-radius: var(--radius-pill);
    color: var(--color-primary-700);
    font-family: var(--font-body);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-medium);
    line-height: 1;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .connectors__stage {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: min(100%, 720px);
    aspect-ratio: 1;
  }

  .connectors__chart {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .connectors__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: var(--radius-pill);
    transform: translate(-50%, -50%);
  }

  .connectors__ring--inner {
    width: 28%;
    height: 28%;
    border: 1px solid var(--color-primary-100);
  }

  .connectors__ring--mid {
    width: 52%;
    height: 52%;
    border: 1px solid var(--color-primary-100);
  }

  .connectors__ring--orbit {
    width: 68%;
    height: 68%;
    border: 1px dashed var(--color-primary-200);
    animation: connectors-spin 56s linear infinite;
  }

  .connectors__ring--field {
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-primary-100);
    opacity: 0.7;
  }

  .connectors__ring--wide {
    width: 148%;
    height: 148%;
    border: 1px dashed var(--color-primary-100);
    opacity: 0.55;
  }

  .connectors__ring--horizon {
    width: 210%;
    height: 210%;
    border: 1px solid var(--color-primary-100);
    opacity: 0.32;
    animation: connectors-spin 120s linear infinite reverse;
  }

  .connectors__spokes {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .connectors__spoke {
    position: absolute;
    inset: 0;
    transform: rotate(var(--angle));
  }

  .connectors__spoke::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 94%;
    width: 42%;
    height: 1px;
    background: var(--color-primary-100);
  }

  .connectors__spoke--satellite::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: 7px;
    height: 7px;
    box-sizing: border-box;
    border: 1px solid var(--color-primary-200);
    border-radius: var(--radius-pill);
    background: var(--color-bg-muted);
    transform: translate(-50%, -50%);
  }

  .connectors__hub {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 132px;
    padding: var(--space-24);
    box-sizing: border-box;
    border-radius: var(--radius-2xl);
    background: var(--color-base-white);
    box-shadow:
      0 0 0 1px var(--color-primary-100),
      0 12px 36px rgb(106 22 122 / 0.1);
    transform: translate(-50%, -50%);
  }

  .connectors__hub::before,
  .connectors__hub::after {
    content: '';
    position: absolute;
    inset: -22px;
    border-radius: inherit;
    border: 1px solid var(--color-primary-200);
    pointer-events: none;
  }

  .connectors__hub::after {
    inset: -22px;
    animation: connectors-pulse 3.8s ease-out infinite;
  }

  .connectors__hub img {
    display: block;
    width: 100%;
    height: auto;
  }

  .connectors__orbit {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .connectors__node {
    position: absolute;
    z-index: 1;
    top: var(--top);
    left: var(--left);
    width: 92px;
    height: 92px;
    transform: translate(-50%, -50%);
    animation: connectors-float 6s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .connectors__disc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 92px;
    height: 92px;
    border-radius: var(--radius-xl);
    background: var(--color-gray-100);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.55),
      0 14px 36px rgb(4 0 5 / 0.22);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .connectors__node:hover,
  .connectors__node:focus-within {
    z-index: 3;
  }

  .connectors__node:hover .connectors__disc,
  .connectors__node:focus-within .connectors__disc {
    transform: scale(1.08);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.8),
      0 0 0 8px rgb(214 194 255 / 0.18),
      0 18px 44px rgb(4 0 5 / 0.3);
  }

  .connectors__disc img {
    display: block;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .connectors__socket {
    position: relative;
    display: block;
    width: 44px;
    height: 44px;
  }

  .connectors__socket-ring {
    position: absolute;
    inset: 0;
    border: 1.5px dashed var(--color-primary-200);
    border-radius: var(--radius-pill);
  }

  .connectors__socket-core {
    position: absolute;
    inset: 14px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-100);
  }

  .connectors__name {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--color-base-white);
    color: var(--color-primary-700);
    box-shadow: 0 0 0 1px var(--color-primary-100);
    font-family: var(--font-display);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    font-optical-sizing: none;
    font-variation-settings: "opsz" var(--font-opsz-figma), "wdth" 100, "wght" 500;
    letter-spacing: 0;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    transform: translate(-50%, -50%) translate(var(--name-x), var(--name-y));
  }

  @keyframes connectors-float {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-50%, calc(-50% - 6px));
    }
  }

  @keyframes connectors-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes connectors-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.28);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connectors__node,
    .connectors__ring--orbit,
    .connectors__ring--horizon,
    .connectors__hub::after {
      animation: none;
      will-change: auto;
    }

    .connectors__disc {
      transition: none;
    }

    .connectors__node:hover .connectors__disc,
    .connectors__node:focus-within .connectors__disc {
      transform: none;
    }
  }

  @media (max-width: 1024px) {
    .connectors {
      padding: var(--space-section-y) var(--space-page);
    }

    .connectors__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-48);
    }

    .connectors__count {
      font-size: var(--font-size-display);
    }

    .connectors__chart {
      display: none;
    }

    .connectors__stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-32);
      width: 100%;
      aspect-ratio: auto;
      height: auto;
    }

    .connectors__hub {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
    }

    .connectors__hub::before,
    .connectors__hub::after {
      display: none;
    }

    .connectors__orbit {
      position: relative;
      display: grid;
      width: 100%;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-24) var(--space-8);
    }

    .connectors__node {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      height: auto;
      transform: none;
      animation: none;
    }

    .connectors__disc {
      width: 72px;
      height: 72px;
      margin: 0 auto;
    }

    .connectors__disc img {
      width: 48px;
      height: 48px;
    }

    .connectors__name {
      position: static;
      margin-top: var(--space-8);
      padding: 0;
      background: none;
      transform: none;
      white-space: normal;
    }
  }

  @media (max-width: 768px) {
    .connectors__inner {
      gap: var(--space-32);
    }

    .connectors__orbit {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-16);
    }

    .connectors__disc {
      width: 64px;
      height: 64px;
    }

    .connectors__disc img {
      width: 42px;
      height: 42px;
    }
  }
</style>

<script>
  const section = document.querySelector('.connectors');

  if (section instanceof HTMLElement) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setPaused = (shouldPause: boolean) => {
      section.classList.toggle('is-paused', shouldPause);
    };

    if (!prefersReducedMotion.matches) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          setPaused(!entry?.isIntersecting);
        },
        { rootMargin: '20% 0px' },
      );

      observer.observe(section);
    }
  }
</script>
