---
import {
  IconBell,
  IconBolt,
  IconChartBar,
  IconCircleCheck,
} from '@tabler/icons-astro';
import Button from './Button.astro';
import Card from './Card.astro';
import SectionHeading from './SectionHeading.astro';

const integrationLogos = [
  { name: 'Slack', src: '/images/logos-integrations/slack.png', tone: 'slack' },
  { name: 'Microsoft Teams', src: '/images/logos-integrations/teams.png' },
  { name: 'Google Chat', src: '/images/logos-integrations/google-chat.png' },
  { name: 'Discord', src: '/images/logos-integrations/discord.png', tone: 'discord' },
];

type FeatureCard = {
  stat: string;
  statLabel: string;
  title: string;
  description: string;
  icon: 'chart' | 'bell' | 'check' | 'bolt';
  showIntegrations?: boolean;
};

const cards: FeatureCard[] = [
  {
    stat: '+50%',
    statLabel: 'd’accès aux données',
    title: 'Rapidité d’accès',
    description:
      "Une vue unifiée et temps réel sur la santé de l'ensemble de votre patrimoine data.",
    icon: 'chart',
  },
  {
    stat: '8',
    statLabel: 'intégrations natives',
    title: 'Intégré à votre écosystème',
    description:
      'Slack, Teams, ServiceNow, EasyVista, Discord — recevez les bonnes alertes au bon endroit.',
    icon: 'bell',
    showIntegrations: true,
  },
  {
    stat: '95%',
    statLabel: 'score qualité moyen',
    title: 'Qualité garantie',
    description:
      'Analyse continue, scoring et alertes automatiques sur la qualité de vos données critiques.',
    icon: 'check',
  },
  {
    stat: '−80%',
    statLabel: "d'intervention manuelle",
    title: 'Automatisation',
    description:
      'Déclenchez des actions préventives instantanées et automatisez vos flux de données.',
    icon: 'bolt',
  },
];
---

<section class="features">
  <div class="features__inner">
    <SectionHeading subtitle="Une plateforme unifiée pensée pour les équipes data et métier, du diagnostic à l'action.">
      Tout ce qu'il faut pour piloter votre data,<br class="break-desktop" /> sans angle mort.
    </SectionHeading>

    <div class="features__grid">
      {
        cards.map((card) => (
          <Card
            stat={card.stat}
            statLabel={card.statLabel}
            title={card.title}
            description={card.description}
          >
            {card.icon === 'chart' && (
              <IconChartBar slot="icon" size={32} stroke={3} />
            )}
            {card.icon === 'bell' && (
              <IconBell slot="icon" size={32} stroke={3} />
            )}
            {card.icon === 'check' && (
              <IconCircleCheck slot="icon" size={32} stroke={3} />
            )}
            {card.icon === 'bolt' && (
              <IconBolt slot="icon" size={32} stroke={3} />
            )}
            {card.showIntegrations && (
              <ul class="features__integrations" slot="stat-media">
                {integrationLogos.map((logo, index) => (
                  <li
                    class:list={[
                      'features__integration',
                      logo.tone && `features__integration--${logo.tone}`,
                    ]}
                    style={`--stack-index: ${index}`}
                  >
                    <img src={logo.src} alt={logo.name} width="32" height="32" />
                  </li>
                ))}
              </ul>
            )}
          </Card>
        ))
      }
    </div>

    <div class="features__cta">
      <Button href="/produit">Découvrir le produit</Button>
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--color-bg-muted);
    padding: var(--space-section-y) var(--space-page);
  }

  .features__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
    max-width: 1408px;
    margin: 0 auto;
  }

  .features__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-gap);
  }

  .features__cta {
    display: flex;
    justify-content: flex-end;
  }

  .features__integrations {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features__integration {
    position: relative;
    z-index: var(--stack-index);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: -10px;
    overflow: hidden;
    box-sizing: border-box;
    border: 2px solid var(--color-base-white);
    border-radius: var(--radius-pill);
    background: var(--color-gray-100);
  }

  .features__integration:first-child {
    margin-left: 0;
  }

  .features__integration img {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .features__integration--slack img {
    width: 18px;
    height: 18px;
  }

  .features__integration--discord {
    background: #5865f2;
  }

  .features__integration--discord img {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 1024px) {
    .features__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .features__inner {
      gap: var(--space-32);
    }

    .features__cta {
      justify-content: flex-start;
    }
  }
</style>
