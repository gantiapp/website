---
import { IconArrowUpRight } from '@tabler/icons-astro';

const links = [
  { href: '/produit', label: 'Produit' },
  { href: '/cas-d-usages', label: "Cas d'usages" },
  { href: '/versions', label: 'Versions' },
  { href: '/tarifs', label: 'Tarifs' },
];
---

<header class="navbar">
  <a class="navbar__brand" href="/">
    <img
      class="navbar__logo"
      src="/images/ganti/ganti.svg"
      alt="Ganti"
      width="91"
      height="31"
    />
  </a>
  <nav class="navbar__nav" aria-label="Navigation principale">
    <ul class="navbar__links">
      {
        links.map((link) => (
          <li>
            <a class="navbar__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="navbar__cta" href="/contact">
    <span>Nous contacter</span>
    <IconArrowUpRight size={20} stroke={1.5} />
  </a>
</header>

<style>
  .navbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-32);
    width: 100%;
    box-sizing: border-box;
    padding: var(--space-32) var(--space-64);
    background: var(--color-bg);
  }

  .navbar__brand {
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .navbar__logo {
    display: block;
    width: 95px;
    height: 32px;
  }

  .navbar__nav {
    justify-self: center;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navbar__link {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__link:hover,
  .navbar__link:focus-visible {
    color: var(--color-text);
  }

  .navbar__cta {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-8);
    padding: var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--color-action);
    color: var(--color-action-text);
    font-family: var(--font-body);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
  }

  .navbar__cta:hover,
  .navbar__cta:focus-visible {
    background: var(--color-primary-600);
  }

  @media (max-width: 768px) {
    .navbar {
      grid-template-columns: 1fr auto;
      padding: var(--space-16) var(--space-24);
      row-gap: var(--space-16);
    }

    .navbar__nav {
      grid-column: 1 / -1;
      justify-self: center;
    }
  }
</style>
