---
import { IconArrowUpRight, IconMenu2, IconX } from '@tabler/icons-astro';

const links = [
  { href: '/produit', label: 'Produit' },
  { href: '/cas-d-usages', label: "Cas d'usages" },
  { href: '/versions', label: 'Versions' },
  { href: '/tarifs', label: 'Tarifs' },
];
---

<header class="navbar" data-navbar>
  <a class="navbar__brand" href="/">
    <img
      class="navbar__logo"
      src="/images/ganti/ganti.svg"
      alt="Ganti"
      width="91"
      height="31"
    />
  </a>
  <button
    class="navbar__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="navbar-menu"
    aria-label="Ouvrir le menu"
    data-navbar-toggle
  >
    <span class="navbar__icon-open">
      <IconMenu2 size={24} stroke={1.5} />
    </span>
    <span class="navbar__icon-close">
      <IconX size={24} stroke={1.5} />
    </span>
    <span class="navbar__toggle-label">Menu</span>
  </button>
  <nav class="navbar__nav" id="navbar-menu" aria-label="Navigation principale" data-navbar-nav>
    <ul class="navbar__links">
      {
        links.map((link) => (
          <li>
            <a class="navbar__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="navbar__contact-item">
        <a class="navbar__link" href="/contact">Nous contacter</a>
      </li>
    </ul>
  </nav>
  <a class="navbar__cta" href="/contact">
    <span>Nous contacter</span>
    <IconArrowUpRight size={20} stroke={1.5} />
  </a>
</header>

<script>
  function setupNavbars() {
    const navbars = document.querySelectorAll('[data-navbar]');
    navbars.forEach((navbar) => {
      if (!(navbar instanceof HTMLElement)) {
        return;
      }

      const toggle = navbar.querySelector('[data-navbar-toggle]');
      if (!(toggle instanceof HTMLButtonElement)) {
        return;
      }

      const setOpen = (isOpen) => {
        navbar.classList.toggle('is-open', isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
      };

      setOpen(false);

      toggle.addEventListener('click', () => {
        setOpen(!navbar.classList.contains('is-open'));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setOpen(false);
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 1024) {
          setOpen(false);
        }
      });
    });
  }

  setupNavbars();
</script>

<style>
  .navbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-32);
    width: 100%;
    box-sizing: border-box;
    padding: var(--space-32) var(--space-page);
    background: var(--color-bg);
  }

  .navbar__brand {
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .navbar__logo {
    display: block;
    width: 95px;
    height: 32px;
  }

  .navbar__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--color-primary-800);
    cursor: pointer;
  }

  .navbar__toggle-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .navbar__icon-open,
  .navbar__icon-close {
    display: flex;
  }

  .navbar__icon-close {
    display: none;
  }

  .navbar.is-open .navbar__icon-open {
    display: none;
  }

  .navbar.is-open .navbar__icon-close {
    display: flex;
  }

  .navbar__nav {
    justify-self: center;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navbar__link {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--font-size-body-large);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__link:hover,
  .navbar__link:focus-visible {
    color: var(--color-text);
  }

  .navbar__cta {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-8);
    padding: var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--color-action);
    color: var(--color-action-text);
    font-family: var(--font-body);
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__contact-item {
    display: none;
  }

  .navbar__cta:hover,
  .navbar__cta:focus-visible {
    background: var(--color-primary-600);
  }

  .navbar :global(svg) {
    display: block;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .navbar {
      grid-template-columns: 1fr auto;
      column-gap: var(--space-12);
    }

    .navbar__toggle {
      display: inline-flex;
      justify-self: end;
    }

    .navbar__cta {
      display: none;
    }

    .navbar__contact-item {
      display: list-item;
    }

    .navbar__nav {
      display: none;
      grid-column: 1 / -1;
      justify-self: stretch;
    }

    .navbar.is-open .navbar__nav {
      display: block;
    }

    .navbar__links {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-16);
      padding: var(--space-16) 0 0;
    }
  }

  @media (max-width: 768px) {
    .navbar {
      padding: var(--space-16) var(--space-24);
    }
  }
</style>
